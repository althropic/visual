{
  "name": "bioses-incite",
  "version": "1.0.0",
  "description": "Design extraction and cloning tool - captures design systems from websites",
  "main": "src/index.js",
  "bin": {
    "bioses-incite": "./bin/cli.js"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPatterns=\"colors|spatial|llm|integration\"",
    "lint": "eslint src/",
    "extract": "node bin/cli.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "keywords": [
    "design-system",
    "design-extraction",
    "tailwind",
    "react",
    "components",
    "web-scraping"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chroma-js": "^3.2.0",
    "dotenv": "^17.2.3",
    "openai": "^6.16.0",
    "playwright": "^1.57.0",
    "simple-statistics": "^7.8.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "jest": "^30.5.2"
  }
}
